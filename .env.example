# API Configuration
# Backend API base URL including /api
# Local development: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# Google sign-in (OAuth Web client id; also set GOOGLE_CLIENT_ID on the backend). Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Privacy-friendly analytics via Plausible. Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=

# Shown on the legal pages and footer
VITE_SUPPORT_EMAIL=support@example.com
VITE_COMPANY_NAME=Resume Diff AI
