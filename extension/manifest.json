{
  "manifest_version": 3,
  "name": "Resume Diff AI – job match",
  "version": "0.1.0",
  "description": "Score your saved resume against the job posting you are viewing.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "action": { "default_popup": "popup.html", "default_title": "Match this job" }
}
